{
  "manifest_version": 3,
  "name": "Outernet",
  "version": "0.3.0",
  "description": "Öffnet von jeder Webseite, jedem Link oder markierten Text aus die passende Outernet-Unterhaltung. Sendet nichts, lädt nichts.",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "action": { "default_title": "Mit Outernet besprechen" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+O" } } },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
